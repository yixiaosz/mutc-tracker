# Trusted shell configuration: quote values and do not put spaces around '='.
# Used by both the Linux systemd service and the macOS launcher.
MUTC_NTFY_TOPIC="mutc-tennis-replace-with-your-long-random-value"
MUTC_POLL_INTERVAL_SECONDS=3600
MUTC_NTFY_SERVER="https://ntfy.sh"
# MUTC_NTFY_TOKEN="your-optional-ntfy-access-token"
# Use absolute paths for service overrides.
# MUTC_STATE_FILE="/absolute/path/to/state.json"
# MUTC_LOG_FILE="/absolute/path/to/tracker.log"
